# 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ============ 核心服务配置 ============
# 监听端口（默认 3000）
PORT=3000

# 运行环境: production | development
# 默认 production。本地热重载调试时可设置为 development
ENV=production

# 代理与管理鉴权密钥（必须修改！）
PROXY_ACCESS_KEY=your-secure-access-key-here

# ============ 界面与日志配置 ============
# 是否启用内置 Web 管理控制台（默认 true）
ENABLE_WEB_UI=true

# 日志输出级别: error | warn | info | debug（默认 info）
LOG_LEVEL=info

# 是否同时在终端/控制台打印实时日志（默认 false，日志始终持久化至 .config/logs.db）
LOG_TO_CONSOLE=false

# 请求/响应日志、超时、请求体限制、指标保留期和 CORS 在设置页「请求与日志」维护。
# 客户端伪装版本在设置页「伪装」维护。首次升级会迁移旧 env 值；已保存设置优先。
