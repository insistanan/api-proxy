# 环境变量示例配置
# 复制此文件为 .env 并修改配置

# ============ 服务器配置 ============
PORT=3000

# 运行环境: development | production
# 未设置时代码默认 production（打包 exe 不写 ENV 也是正式模式）
# 影响:
#   - production: Gin ReleaseMode、关闭 /admin/dev/info、CORS 用 CORS_ORIGIN
#   - development: Gin DebugMode、开启 /admin/dev/info、允许 localhost CORS
# 请求/响应体、合成流内容不跟 ENV 走，只看下方 ENABLE_*_LOGS / SSE_DEBUG_LEVEL / RAW_LOG_OUTPUT
# 本地热重载请显式写 ENV=development
ENV=production

# ============ Web UI 配置 ============
# 是否启用 Web 管理界面
ENABLE_WEB_UI=true

# ============ 访问控制 ============
# 代理访问密钥（必须修改！）
PROXY_ACCESS_KEY=your-secure-access-key-here

# ============ 日志配置 ============
# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# 是否同时输出到控制台（终端黑框框）
# false: 仅写入 .config/logs.db，适合后台运行或生产环境，避免终端输出瓶颈
# true: 同时在控制台打印实时日志，适合调试排查
LOG_TO_CONSOLE=false

# 是否启用请求/响应日志
# 注意：代码默认值为 true，注释掉此项等于启用日志
# 要禁用日志必须显式设置为 false，不能通过注释来禁用
ENABLE_REQUEST_LOGS=false
ENABLE_RESPONSE_LOGS=false

# 静默模式：轮询端点、健康检查、OPTIONS 预检完全不打印日志；
# 其余请求以"请求块"形式打印（┌ 进入 / └ 结束，含状态码与耗时），便于区分每个请求的日志区间
# 设为 false 时恢复 gin 标准访问日志（所有请求单行输出）
QUIET_POLLING_LOGS=true

# 原始日志输出（不缩进、不截断、不重排序，直接输出完整请求/响应内容）
RAW_LOG_OUTPUT=false

# SSE 调试级别: off | summary | full
# full: 记录每个 SSE 事件的类型、长度、content_block 详情
# summary: 仅在流结束时记录事件统计摘要
# off: 关闭 SSE 调试日志（默认）
SSE_DEBUG_LEVEL=off

# ============ 日志 sqlite ============
# 运行日志 / 流量正文 / 请求元数据。保留今天与昨天，查询：api-proxy logs query/show
LOG_DB_PATH=.config/logs.db

# ============ 协议与响应改写配置 ============
# 是否改写响应中的 model 字段为请求的 model（默认 false）
# 启用后，当上游返回的 model 与请求的 model 不一致时，会自动改写为请求的 model
# 注意：仅影响 Messages API 的流式响应，不影响 Responses API 和 Gemini API
REWRITE_RESPONSE_MODEL=false

# 是否校正 Responses 透传分支中明显错报的 input_tokens（默认 true）
# 仅修正下发给客户端的 usage，计费与画像保持真实原值
CORRECT_RESPONSES_INPUT_TOKENS=true

# ============ 性能与超时配置 ============
# 请求超时时间（毫秒）
REQUEST_TIMEOUT=300000

# 请求体最大大小（MB），默认 50
MAX_REQUEST_BODY_SIZE_MB=50

# 等待上游响应头超时时间（秒），默认 120，范围 30-300
# 仅对非流式请求生效；流式请求（SSE）不设此超时，避免长推理首字节延迟导致误超时
RESPONSE_HEADER_TIMEOUT=120

# 流式响应空闲超时（秒），默认 300（5 分钟），范围 30-3600
# 检测上游长连接建立但挂起无数据推送的异常情况
STREAM_IDLE_TIMEOUT=300

# ============ 协议配置 ============
# 上游请求统一走 HTTP/1.1（固定、不可配置）
# 历史原因：HTTP/2 在部分代理/上游下会触发 "http2: timeout awaiting response headers"，
# 因此客户端固定使用 HTTP/1.1 连接上游以规避该问题。旧的 FORCE_HTTP1 环境变量已废弃、不再生效。

# ============ 客户端伪装配置 ============
# Claude Code 伪装版本号（伪装开关开启时生效）
# 写入 User-Agent、请求体计费块 cc_version 与会话指纹；不配置时使用内置默认值 2.1.238
#CLAUDE_CODE_DISGUISE_VERSION=2.1.238

# Codex CLI 伪装版本号（伪装开关开启时生效）
# 写入 User-Agent 与 version 头；不配置时使用内置默认值 0.150.1
#CODEX_DISGUISE_VERSION=0.150.1

# ============ CORS 配置 ============
ENABLE_CORS=false
CORS_ORIGIN=*

# ============ 熔断指标配置 ============
# 滑动窗口大小（最小 3，默认 10）
METRICS_WINDOW_SIZE=10
# 失败率阈值（0-1，默认 0.5 即 50%）
METRICS_FAILURE_THRESHOLD=0.5

# ============ 指标持久化配置 ============
# 是否启用 SQLite 持久化（默认 true）
# 启用后重启服务不会丢失历史指标数据
METRICS_PERSISTENCE_ENABLED=true
# 数据保留天数（3-30，默认 7）
METRICS_RETENTION_DAYS=7
